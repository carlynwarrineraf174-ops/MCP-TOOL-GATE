{
  "get_weather":  {
    "description": "查询特定城市的天气。",
    "input_schema": {
      "properties": {
        "city": {
          "title": "City",
          "type": "string"
        },
        "unit": {
          "default": "c",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "city"
      ],
      "title": "get_weatherArguments",
      "type": "object"
    },
    "output_schema": null
  },
  "query_order": {
    "description": "按订单号查询订单状态。",
    "input_schema": {
      "properties": {
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "with_items": {
          "default": false,
          "title": "With Items",
          "type": "boolean"
        }
      },
      "required": [
        "order_id"
      ],
      "title": "query_orderArguments",
      "type": "object"
    },
    "output_schema": null
  },
  "search_doc": {
    "description": "在知识库里检索相关文档片段。",
    "input_schema": {
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "top_k": {
          "default": 3,
          "title": "Top K",
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "title": "search_docArguments",
      "type": "object"
    },
    "output_schema": null
  }
}
